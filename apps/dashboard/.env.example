# Optional: copy to .env.local when the engine is not at the default address.
# Browser-visible; set before building. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:8787

# Server-side override for demo requests; defaults to the browser URL above.
ORCHESTRATOR_URL=http://127.0.0.1:8787
